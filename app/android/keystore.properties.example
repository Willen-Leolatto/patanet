# Copy this file to android/keystore.properties (which is gitignored) and
# fill in real values for local release builds. Never commit the real file.
#
# In CI/CD, skip this file entirely and set the equivalent MYAPP_UPLOAD_*
# environment variables instead — android/app/build.gradle falls back to
# them automatically when keystore.properties is absent.

storeFile=patanet-release.jks
storePassword=CHANGE_ME
keyAlias=patanet
keyPassword=CHANGE_ME
