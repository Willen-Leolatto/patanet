NODE_ENV='development'

APP_PORT=3001

# PostgreSQL 16 (Docker Desktop - container "postgres", ver docker-compose.yml)
# Porta 5434 (nao a 5432 padrao) para nao colidir com outros Postgres locais.
DATABASE_URL="postgresql://postgres:docker@localhost:5434/patanet_dev?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d

CORS_WHITELIST=

# AWS S3 / MinIO
AWS_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=patanet

# Google OAuth
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=

# Administração & Moderação
ADMIN_EMAILS="dev.patanet@gmail.com"

# Canal de Denúncias (Triagem inicial por e-mail & Webhook para Órgãos Públicos)
REPORT_FORWARDING_EMAIL="dev.patanet@gmail.com"
PUBLIC_AUTHORITY_REPORT_WEBHOOK=""

# Conformidade Google Play Store & LGPD
PLAY_STORE_ACCOUNT_DELETION_URL="https://patanet.app.br/delete-account"
PRIVACY_POLICY_URL="https://patanet.app.br/privacy"
TERMS_OF_SERVICE_URL="https://patanet.app.br/terms"
CURRENT_TERMS_VERSION="1.0"