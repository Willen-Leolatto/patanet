import { http } from './axios.js'

export async function createProcedure(orgId, payload) {
  const { data } = await http.post(`/orgs/${orgId}/procedures`, payload)
  return data
}

export async function listProcedures(orgId) {
  const { data } = await http.get(`/orgs/${orgId}/procedures`)
  return data
}

export async function requestAppointment(payload) {
  const { data } = await http.post('/appointments/request', payload)
  return data
}

export async function vetAcceptAppointment(id) {
  const { data } = await http.post(`/appointments/${id}/vet/accept`)
  return data
}

export async function vetDeclineAppointment(id) {
  const { data } = await http.post(`/appointments/${id}/vet/decline`)
  return data
}

export async function vetProposeTime(id, payload) {
  const { data } = await http.post(`/appointments/${id}/vet/propose-time`, payload)
  return data
}

export async function tutorAcceptTime(id) {
  const { data } = await http.post(`/appointments/${id}/tutor/accept-time`)
  return data
}

export async function tutorRejectTime(id) {
  const { data } = await http.post(`/appointments/${id}/tutor/reject-time`)
  return data
}

export async function setAppointmentProcedure(id, payload) {
  const { data } = await http.post(`/appointments/${id}/vet/set-procedure`, payload)
  return data
}

export async function myAgenda(orgId, params = {}) {
  const { data } = await http.get(`/vet/agenda/${orgId}`, { params })
  return data
}

export async function tutorAppointments() {
  const { data } = await http.get('/tutor/appointments')
  return data
}
